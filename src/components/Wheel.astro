---
// Placeholder mark shown until a photo exists for the item.
interface Props { color?: string; size?: number; label?: string; }
const { color = '#8a8a83', size = 36, label = '' } = Astro.props;
---
<svg
  width={size} height={size} viewBox="0 0 100 100"
  style={`color:${color};flex:none`}
  role={label ? 'img' : 'presentation'}
  aria-label={label || undefined}
  aria-hidden={label ? undefined : 'true'}
>
  <circle cx="50" cy="50" r="48" fill="currentColor" />
  <circle cx="50" cy="50" r="29" fill="#e9e6df" />
  <g fill="currentColor">
    <circle cx="50" cy="30" r="4.6" /><circle cx="67.3" cy="40" r="4.6" />
    <circle cx="67.3" cy="60" r="4.6" /><circle cx="50" cy="70" r="4.6" />
    <circle cx="32.7" cy="60" r="4.6" /><circle cx="32.7" cy="40" r="4.6" />
  </g>
  <circle cx="50" cy="50" r="11" fill="#2f3237" />
  <circle cx="50" cy="50" r="5.5" fill="#e9e6df" />
</svg>
