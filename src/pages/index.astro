---
import Base from '../layouts/Base.astro';
import Wheel from '../components/Wheel.astro';
import { items, facets, firstPhoto, srcset, unidentified } from '../lib/items';
import { url } from '../lib/url';

// Durometer is colour-coded on the wheel itself, so mirror that in the
// placeholder marks shown before photos are processed.
const durColor: Record<string, string> = {
  '86A': '#2f7f92',
  '88A': '#c1553a',
  'XFirm': '#26282c',
  'Firm': '#6b6f76',
};
const colorFor = (d?: string) => (d && durColor[d]) || '#8a8a83';

const cards = [...items].sort(
  (a, b) => a.category.localeCompare(b.category) || (b.diameter_mm ?? 0) - (a.diameter_mm ?? 0),
);

const unknownShots = unidentified
  .map((photo) => srcset(photo))
  .filter((s): s is NonNullable<typeof s> => s !== null);
---

<Base title="Suhas Skates">
  <section class="intro">
    <h1>Inline speed gear</h1>
    <p>
      Wheels, frames and complete skates. Filter by diameter or durometer to
      narrow the collection.
    </p>
  </section>

  <div class="filters">
    <div class="frow">
      <span class="flabel">Category</span>
      {facets.category.map((c) => (
        <button class="chip" type="button" aria-pressed="false" data-facet="category" data-value={c}>{c}</button>
      ))}
    </div>

    {facets.diameter.length > 0 && (
      <div class="frow">
        <span class="flabel">Diameter</span>
        {facets.diameter.map((d) => (
          <button class="chip" type="button" aria-pressed="false" data-facet="diameter" data-value={String(d)}>{d} mm</button>
        ))}
      </div>
    )}

    {facets.durometer.length > 0 && (
      <div class="frow">
        <span class="flabel">Durometer</span>
        {facets.durometer.map((d) => (
          <button class="chip" type="button" aria-pressed="false" data-facet="durometer" data-value={d}>{d}</button>
        ))}
        <button class="chip chip-clear" type="button" id="clear" hidden>Clear filters</button>
      </div>
    )}
  </div>

  <ul class="gallery" id="gallery">
    {cards.map((item) => {
      const img = firstPhoto(item);
      const spec = [
        item.diameter_mm ? `${item.diameter_mm} mm` : null,
        item.durometer ?? null,
      ].filter(Boolean).join(' · ');

      return (
        <li
          data-category={item.category}
          data-diameter={item.diameter_mm ?? ''}
          data-durometer={item.durometer ?? ''}
        >
          <a href={url(`/items/${item.id}/`)}>
            <span class="shot">
              {img ? (
                <img src={img.src} srcset={img.srcset}
                     sizes="(max-width: 560px) 45vw, (max-width: 900px) 30vw, 240px"
                     width="800" height="800" loading="lazy" decoding="async"
                     alt={`${item.brand} ${item.name}`} />
              ) : (
                <Wheel color={colorFor(item.durometer)} size={78} />
              )}
            </span>
            <span class="label">
              <span class="name">{item.name}</span>
              <span class="brand">{item.brand}</span>
              {spec && <span class="spec">{spec}</span>}
            </span>
          </a>
        </li>
      );
    })}
  </ul>

  <p class="empty" id="empty" hidden>Nothing matches those filters.</p>

  {unidentified.length > 0 && (
    <section class="unknown">
      <p class="sub">Not yet identified</p>
      <ul class="gallery bare">
        {unknownShots.length > 0
          ? unknownShots.map((img) => (
              <li>
                <span class="shot">
                  <img src={img.src} srcset={img.srcset}
                       sizes="(max-width: 560px) 45vw, (max-width: 900px) 30vw, 240px"
                       width="800" height="800" loading="lazy" decoding="async" alt="" />
                </span>
              </li>
            ))
          : unidentified.map(() => (
              <li><span class="shot"><Wheel size={78} /></span></li>
            ))}
      </ul>
    </section>
  )}
</Base>

<script>
  const gallery = document.getElementById('gallery');
  const empty = document.getElementById('empty');
  const clear = document.getElementById('clear') as HTMLButtonElement | null;
  if (!gallery || !empty || !clear) throw new Error('catalogue markup missing');

  const chips = [...document.querySelectorAll<HTMLButtonElement>('.chip[data-facet]')];
  const tiles = [...gallery.children] as HTMLElement[];

  /** facet name -> selected values. An empty set means "no constraint". */
  const active = new Map<string, Set<string>>();

  function apply() {
    let shown = 0;
    for (const tile of tiles) {
      const ok = [...active].every(([facet, values]) =>
        values.size === 0 || values.has(tile.dataset[facet] ?? ''),
      );
      tile.hidden = !ok;
      if (ok) shown++;
    }
    empty.hidden = shown > 0;
    clear.hidden = [...active.values()].every((v) => v.size === 0);
    writeUrl();
  }

  function writeUrl() {
    const params = new URLSearchParams();
    for (const [facet, values] of active) {
      if (values.size) params.set(facet, [...values].join(','));
    }
    const qs = params.toString();
    history.replaceState(null, '', qs ? `?${qs}` : location.pathname);
  }

  function readUrl() {
    const params = new URLSearchParams(location.search);
    for (const chip of chips) {
      const { facet, value } = chip.dataset as { facet: string; value: string };
      if ((params.get(facet)?.split(',') ?? []).includes(value)) {
        chip.setAttribute('aria-pressed', 'true');
        active.get(facet)!.add(value);
      }
    }
  }

  for (const chip of chips) {
    const { facet, value } = chip.dataset as { facet: string; value: string };
    if (!active.has(facet)) active.set(facet, new Set());
    chip.addEventListener('click', () => {
      const set = active.get(facet)!;
      const on = chip.getAttribute('aria-pressed') === 'true';
      if (on) set.delete(value);
      else set.add(value);
      chip.setAttribute('aria-pressed', String(!on));
      apply();
    });
  }

  clear.addEventListener('click', () => {
    for (const set of active.values()) set.clear();
    for (const chip of chips) chip.setAttribute('aria-pressed', 'false');
    apply();
  });

  readUrl();
  apply();
</script>
