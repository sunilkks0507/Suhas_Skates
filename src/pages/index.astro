---
import Base from '../layouts/Base.astro';
import { photos } from '../lib/photos';
---

<Base title="Suhas Skates">
  <header class="top">
    <h1 class="wordmark">Suhas Skates</h1>
    <p class="sub">Inline speed</p>
  </header>

  {photos.length === 0 ? (
    <p class="none">
      <b>No photographs yet</b>
      Put the originals in <code>raw/</code> and run <code>npm run images</code>
    </p>
  ) : (
    <main class="sheet">
      {photos.map((photo, i) => (
        <button class="frame" type="button" data-i={i} aria-label={`Open photograph ${i + 1}`}>
          <img
            src={photo.src}
            srcset={photo.srcset}
            sizes="(max-width: 380px) 100vw, (max-width: 760px) 50vw, (max-width: 1200px) 33vw, 25vw"
            width={photo.width}
            height={photo.height}
            loading={i < 8 ? 'eager' : 'lazy'}
            decoding="async"
            alt=""
          />
        </button>
      ))}
    </main>
  )}

  {photos.length > 0 && (
    <div class="viewer" id="viewer" role="dialog" aria-modal="true" aria-label="Photograph viewer">
      <button class="shut bar-btn" id="shut" type="button" aria-label="Close">✕</button>
      <div class="stage"><img id="stage-img" alt="" /></div>
      <div class="bar">
        <button id="prev" type="button" aria-label="Previous">←</button>
        <span class="count" id="count"></span>
        <button id="next" type="button" aria-label="Next">→</button>
      </div>
    </div>
  )}
</Base>

<script>
  const frames = [...document.querySelectorAll<HTMLButtonElement>('.frame')];
  const viewer = document.getElementById('viewer');
  const stage = document.getElementById('stage-img') as HTMLImageElement | null;
  const count = document.getElementById('count');
  if (frames.length && viewer && stage && count) {
    // Full-resolution source for each photograph, read off the thumbnails.
    const shots = frames.map((f) => {
      const img = f.querySelector('img')!;
      return { src: img.currentSrc || img.src, srcset: img.srcset };
    });

    let at = 0;
    let lastFocus: HTMLElement | null = null;

    const pad = (n: number) => String(n).padStart(2, '0');

    function show(i: number) {
      at = (i + shots.length) % shots.length;
      stage!.srcset = shots[at].srcset;
      stage!.sizes = '100vw';
      stage!.src = shots[at].src;
      count!.textContent = `${pad(at + 1)} / ${pad(shots.length)}`;
      // Warm the neighbours so arrowing through is instant.
      for (const j of [at + 1, at - 1]) {
        const n = (j + shots.length) % shots.length;
        const pre = new Image();
        pre.srcset = shots[n].srcset;
        pre.sizes = '100vw';
        pre.src = shots[n].src;
      }
    }

    function open(i: number) {
      lastFocus = document.activeElement as HTMLElement;
      show(i);
      viewer!.setAttribute('data-open', '');
      document.body.style.overflow = 'hidden';
      (document.getElementById('shut') as HTMLButtonElement).focus();
    }

    function close() {
      viewer!.removeAttribute('data-open');
      document.body.style.overflow = '';
      lastFocus?.focus();
    }

    frames.forEach((f, i) => f.addEventListener('click', () => open(i)));
    document.getElementById('shut')!.addEventListener('click', close);
    document.getElementById('prev')!.addEventListener('click', () => show(at - 1));
    document.getElementById('next')!.addEventListener('click', () => show(at + 1));

    // Clicking the backdrop closes; clicking the photograph itself does not.
    viewer.addEventListener('click', (e) => {
      if (e.target === viewer || (e.target as HTMLElement).classList.contains('stage')) close();
    });

    document.addEventListener('keydown', (e) => {
      if (!viewer.hasAttribute('data-open')) return;
      if (e.key === 'Escape') close();
      else if (e.key === 'ArrowRight') show(at + 1);
      else if (e.key === 'ArrowLeft') show(at - 1);
    });

    // Swipe on touch devices.
    let x0 = 0;
    viewer.addEventListener('touchstart', (e) => { x0 = e.changedTouches[0].clientX; }, { passive: true });
    viewer.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - x0;
      if (Math.abs(dx) > 50) show(dx < 0 ? at + 1 : at - 1);
    }, { passive: true });
  }
</script>
