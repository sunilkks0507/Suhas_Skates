---
import Base from '../layouts/Base.astro';
import Wheel from '../components/Wheel.astro';
import { items, facets, totals, firstPhoto } from '../lib/items';
import { url } from '../lib/url';

// Durometer is colour-coded on the wheel itself, so mirror that in the table.
const durColor: Record<string, string> = {
  '86A': '#2f7f92',
  '88A': '#c1553a',
  'XFirm': '#26282c',
  'Firm': '#6b6f76',
};
const colorFor = (d?: string) => (d && durColor[d]) || '#8a8a83';

const rows = [...items].sort(
  (a, b) => a.category.localeCompare(b.category) || (b.diameter_mm ?? 0) - (a.diameter_mm ?? 0),
);
---

<Base title="Skate Catalogue">
  <section class="intro">
    <h1>Inline speed gear</h1>
    <p>
      Wheels, frames and complete skates, listed by specification. Filter by diameter or durometer
      to narrow the table, or sort any column.
    </p>
    <p class="tally">
      <span><b>{totals.items}</b> items</span>
      <span><b>{totals.units}</b> units</span>
      <span><b>{facets.category.length}</b> categories</span>
    </p>
  </section>

  <div class="filters">
    <div class="frow">
      <span class="flabel" id="f-cat">Category</span>
      {facets.category.map((c) => (
        <button class="chip" type="button" aria-pressed="false" data-facet="category" data-value={c}>{c}</button>
      ))}
    </div>

    {facets.diameter.length > 0 && (
      <div class="frow">
        <span class="flabel">Diameter</span>
        {facets.diameter.map((d) => (
          <button class="chip" type="button" aria-pressed="false" data-facet="diameter" data-value={String(d)}>{d} mm</button>
        ))}
      </div>
    )}

    {facets.durometer.length > 0 && (
      <div class="frow">
        <span class="flabel">Durometer</span>
        {facets.durometer.map((d) => (
          <button class="chip" type="button" aria-pressed="false" data-facet="durometer" data-value={d}>{d}</button>
        ))}
      </div>
    )}

    <div class="frow">
      <span class="flabel">Condition</span>
      {facets.condition.map((c) => (
        <button class="chip" type="button" aria-pressed="false" data-facet="condition" data-value={c}>{c}</button>
      ))}
      <button class="chip chip-clear" type="button" id="clear" hidden>Clear filters</button>
    </div>
  </div>

  <div class="tablewrap">
    <table class="spec" id="grid">
      <thead>
        <tr>
          <th scope="col"><button type="button" data-sort="name">Item <span class="dir">↓</span></button></th>
          <th scope="col"><button type="button" data-sort="diameter">Ø <span class="dir">↓</span></button></th>
          <th scope="col"><button type="button" data-sort="durometer">Durometer <span class="dir">↓</span></button></th>
          <th scope="col"><button type="button" data-sort="qty">Qty <span class="dir">↓</span></button></th>
          <th scope="col"><button type="button" data-sort="condition">Condition <span class="dir">↓</span></button></th>
        </tr>
      </thead>
      <tbody>
        {rows.map((item) => {
          const img = firstPhoto(item);
          return (
            <tr
              data-category={item.category}
              data-diameter={item.diameter_mm ?? ''}
              data-durometer={item.durometer ?? ''}
              data-condition={item.condition}
              data-name={`${item.brand} ${item.name}`}
              data-qty={item.qty}
            >
              <td class="item">
                <div class="cellrow">
                  {img ? (
                    <img class="thumb" src={img.src} srcset={img.srcset} sizes="36px"
                         width="36" height="36" loading="lazy" decoding="async" alt="" />
                  ) : (
                    <Wheel color={colorFor(item.durometer)} size={36} />
                  )}
                  <span>
                    <a href={url(`/items/${item.id}/`)}>{item.name}</a>
                    <span class="brand">{item.brand} · {item.category}</span>
                  </span>
                </div>
              </td>
              <td>{item.diameter_mm ? `${item.diameter_mm} mm` : '—'}</td>
              <td>
                {item.durometer ? (
                  <><i class="dur" style={`background:${colorFor(item.durometer)}`} aria-hidden="true"></i>{item.durometer}</>
                ) : '—'}
              </td>
              <td>{item.qty}</td>
              <td><span class={`tag ${item.condition === 'new' ? 'new' : ''}`}>{item.condition}</span></td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>

  <p class="empty" id="empty" hidden>No items match those filters.</p>
</Base>

<script>
  const table = document.getElementById('grid') as HTMLTableElement | null;
  const empty = document.getElementById('empty');
  const clear = document.getElementById('clear') as HTMLButtonElement | null;
  if (!table || !empty || !clear) throw new Error('catalogue markup missing');

  const body = table.tBodies[0];
  const chips = [...document.querySelectorAll<HTMLButtonElement>('.chip[data-facet]')];
  const sorters = [...document.querySelectorAll<HTMLButtonElement>('th button[data-sort]')];
  const allRows = [...body.rows];

  /** facet name -> set of selected values. Empty set means "no constraint". */
  const active = new Map<string, Set<string>>();

  function apply() {
    let shown = 0;
    for (const row of allRows) {
      const ok = [...active].every(([facet, values]) =>
        values.size === 0 || values.has(row.dataset[facet] ?? ''),
      );
      row.hidden = !ok;
      if (ok) shown++;
    }
    empty.hidden = shown > 0;
    clear.hidden = [...active.values()].every((v) => v.size === 0);
    writeUrl();
  }

  function writeUrl() {
    const params = new URLSearchParams();
    for (const [facet, values] of active) {
      if (values.size) params.set(facet, [...values].join(','));
    }
    const qs = params.toString();
    history.replaceState(null, '', qs ? `?${qs}` : location.pathname);
  }

  function readUrl() {
    const params = new URLSearchParams(location.search);
    for (const chip of chips) {
      const { facet, value } = chip.dataset as { facet: string; value: string };
      const selected = params.get(facet)?.split(',') ?? [];
      if (selected.includes(value)) {
        chip.setAttribute('aria-pressed', 'true');
        if (!active.has(facet)) active.set(facet, new Set());
        active.get(facet)!.add(value);
      }
    }
  }

  for (const chip of chips) {
    const { facet, value } = chip.dataset as { facet: string; value: string };
    if (!active.has(facet)) active.set(facet, new Set());
    chip.addEventListener('click', () => {
      const set = active.get(facet)!;
      const on = chip.getAttribute('aria-pressed') === 'true';
      if (on) set.delete(value);
      else set.add(value);
      chip.setAttribute('aria-pressed', String(!on));
      apply();
    });
  }

  clear.addEventListener('click', () => {
    for (const set of active.values()) set.clear();
    for (const chip of chips) chip.setAttribute('aria-pressed', 'false');
    apply();
  });

  const NUMERIC = new Set(['diameter', 'qty']);

  for (const button of sorters) {
    button.addEventListener('click', () => {
      const key = button.dataset.sort!;
      const th = button.closest('th')!;
      const descending = th.getAttribute('aria-sort') === 'descending';
      const next = descending ? 'ascending' : 'descending';

      for (const other of sorters) other.closest('th')!.removeAttribute('aria-sort');
      th.setAttribute('aria-sort', next);
      button.querySelector('.dir')!.textContent = next === 'ascending' ? '↑' : '↓';

      const sign = next === 'ascending' ? 1 : -1;
      const sorted = [...allRows].sort((a, b) => {
        const x = a.dataset[key] ?? '';
        const y = b.dataset[key] ?? '';
        if (NUMERIC.has(key)) return sign * ((Number(x) || 0) - (Number(y) || 0));
        return sign * x.localeCompare(y);
      });
      for (const row of sorted) body.appendChild(row);
    });
  }

  readUrl();
  apply();
</script>
