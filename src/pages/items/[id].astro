---
import Base from '../../layouts/Base.astro';
import Wheel from '../../components/Wheel.astro';
import { items, srcset, type Item } from '../../lib/items';

export function getStaticPaths() {
  return items.map((item) => ({ params: { id: item.id }, props: { item } }));
}

interface Props { item: Item }
const { item } = Astro.props;

// Only photos that have been through the optimiser can be displayed.
const shots = item.photos.map(srcset).filter((s): s is NonNullable<typeof s> => s !== null);

const props: Array<[string, string]> = [
  ['Brand', item.brand],
  ['Category', item.category],
  ...(item.diameter_mm ? ([['Diameter', `${item.diameter_mm} mm`]] as Array<[string, string]>) : []),
  ...(item.durometer ? ([['Durometer', item.durometer]] as Array<[string, string]>) : []),
  ['Quantity', String(item.qty)],
  ['Condition', item.condition],
];
---

<Base title={`${item.brand} ${item.name}`} description={`${item.brand} ${item.name} — ${item.category}`}>
  <div class="detail">
    <div class="shots">
      {shots.length > 0 ? (
        shots.map((img, i) => (
          <img
            src={img.src} srcset={img.srcset}
            sizes="(max-width: 720px) 100vw, 560px"
            width="800" height="800"
            loading={i === 0 ? 'eager' : 'lazy'} decoding="async"
            alt={`${item.brand} ${item.name}, view ${i + 1} of ${shots.length}`}
          />
        ))
      ) : (
        <div class="missing">
          <Wheel size={64} />
          <p>No processed photo yet.<br />Run <code>npm run images</code>, or add filenames to the<br /><code>photos</code> column in data/items.csv.</p>
        </div>
      )}
    </div>

    <div>
      <h1>{item.name}</h1>
      <p class="brandline">{item.brand}</p>

      <dl class="props">
        {props.map(([label, value]) => (
          <div><dt>{label}</dt><dd>{value}</dd></div>
        ))}
      </dl>

      {item.notes && <p style="color:var(--ink-2);margin-top:18px;max-width:52ch">{item.notes}</p>}

      <a class="backlink" href="/">← All items</a>
    </div>
  </div>
</Base>
